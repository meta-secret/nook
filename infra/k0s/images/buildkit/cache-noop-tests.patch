+package cache
+
+import (
+	"errors"
+	"path/filepath"
+	"sync"
+	"testing"
+
+	"github.com/moby/buildkit/cache/metadata"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestQueueUnknownSizeDurableNoop(t *testing.T) {
+	s, err := metadata.NewStore(filepath.Join(t.TempDir(), "metadata.db"))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+	si, _ := s.Get("record")
+	md := &cacheMetadata{si: si}
+	require.NoError(t, md.queueSize(42))
+	require.NoError(t, md.commitMetadata())
+	stale, _ := s.Get("record")
+	require.NoError(t, md.queueSize(sizeUnknown))
+	require.NoError(t, md.commitMetadata())
+	var bdb *bolt.DB
+	require.NoError(t, s.DB().View(func(tx *bolt.Tx) error { bdb = tx.DB(); return nil }))
+	stats := bdb.Stats()
+	before := stats.TxStats.GetWrite()
+	staleMD := &cacheMetadata{si: stale}
+	require.Equal(t, int64(42), staleMD.getSize())
+	for range 16 {
+		require.NoError(t, staleMD.queueSize(sizeUnknown))
+		require.NoError(t, staleMD.commitMetadata())
+	}
+	stats = bdb.Stats()
+	writes := stats.TxStats.GetWrite() - before
+	t.Logf("16 durable unknown-size updates: bbolt writes=%d", writes)
+	require.Zero(t, writes)
+	require.Equal(t, sizeUnknown, staleMD.getSize(), "durable match refreshes stale mirror")
+	fresh, _ := s.Get("record")
+	require.Equal(t, sizeUnknown, (&cacheMetadata{si: fresh}).getSize())
+	// A different handle may change durable size while this handle remembers unknown.
+	require.NoError(t, md.queueSize(73))
+	require.NoError(t, md.commitMetadata())
+	require.NoError(t, staleMD.queueSize(sizeUnknown))
+	require.NoError(t, staleMD.commitMetadata())
+	fresh, _ = s.Get("record")
+	require.Equal(t, sizeUnknown, (&cacheMetadata{si: fresh}).getSize())
+}
