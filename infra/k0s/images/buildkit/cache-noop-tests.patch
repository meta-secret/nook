+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+	si, _ := s.Get("record")
+	md := &cacheMetadata{si: si}
+	require.NoError(t, md.queueSize(sizeUnknown))
+	require.NoError(t, md.commitMetadata())
+	order := []string{}
+	v, err := metadata.NewValue("written")
+	require.NoError(t, err)
+	si.Queue(func(b *bolt.Bucket) error { order = append(order, "before"); return si.SetValue(b, "first", v) })
+	require.NoError(t, md.queueSize(sizeUnknown))
+	si.Queue(func(b *bolt.Bucket) error { order = append(order, "after"); return si.SetValue(b, "second", v) })
+	failure := errors.New("late callback failure")
+	fail := true
+	si.Queue(func(*bolt.Bucket) error {
+		order = append(order, "last")
+		if fail {
+			return failure
+		}
+		return nil
+	})
+	require.ErrorIs(t, md.commitMetadata(), failure)
+	fresh, _ := s.Get("record")
+	require.Nil(t, fresh.Get("first"))
+	require.Nil(t, fresh.Get("second"))
+	fail = false
+	require.NoError(t, md.commitMetadata())
+	require.Equal(t, []string{"before", "after", "last", "before", "after", "last"}, order)
+	fresh, _ = s.Get("record")
+	require.Equal(t, v, fresh.Get("first"))
+	require.Equal(t, v, fresh.Get("second"))
+	require.Equal(t, sizeUnknown, (&cacheMetadata{si: fresh}).getSize())
+	require.NoError(t, md.commitMetadata())
+	require.Len(t, order, 6, "successful commit consumes the queue")
