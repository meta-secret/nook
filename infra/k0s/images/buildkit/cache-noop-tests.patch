+package metadata
+
+import (
+	"errors"
+	"path/filepath"
+	"testing"
+
+	"github.com/moby/buildkit/util/db"
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+// Fail after callbacks ran but before the native writable transaction commits.
+// The real bbolt rollback remains responsible for discarding all mutations.
+type failQueueCommitDB struct {
+	db.DB
+	fail    bool
+	failure error
+}
+
+func (d *failQueueCommitDB) Update(fn func(*bolt.Tx) error) error {
+	return d.DB.Update(func(tx *bolt.Tx) error {
+		if err := fn(tx); err != nil {
+			return err
+		}
+		if d.fail {
+			return d.failure
+		}
+		return nil
+	})
+}
+
+func TestQueueValueCommitFailureRetainsPending(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "metadata.db")
+	s, err := NewStore(filename)
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+	si, _ := s.Get("record")
+	known, err := NewValue(int64(42))
+	require.NoError(t, err)
+	unknown, err := NewValue(int64(-1))
+	require.NoError(t, err)
+	require.NoError(t, si.Update(func(b *bolt.Bucket) error { return si.SetValue(b, "size", known) }))
+	failDB := &failQueueCommitDB{DB: s.db, fail: true, failure: errors.New("commit failed after callbacks")}
+	s.db = failDB
+	si.Queue(func(b *bolt.Bucket) error { return si.SetValue(b, "size", unknown) })
+	require.ErrorIs(t, si.Commit(), failDB.failure)
+	require.Len(t, si.queue, 1)
+	require.Equal(t, unknown, si.Get("size"), "mirror changed before failed commit")
+	fresh, _ := s.Get("record")
+	require.Equal(t, known, fresh.Get("size"), "durable state rolled back")
+	failDB.fail = false
+	require.NoError(t, si.Commit())
+	require.Empty(t, si.queue)
+	require.NoError(t, s.Close())
+	s, err = NewStore(filename)
+	require.NoError(t, err)
+	fresh, _ = s.Get("record")
+	require.Equal(t, unknown, fresh.Get("size"), "retry uses durable state despite mirror")
+}
