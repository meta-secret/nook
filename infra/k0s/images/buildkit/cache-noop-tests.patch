+func TestQueueUnknownSizeConcurrent(t *testing.T) {
+	s, err := metadata.NewStore(filepath.Join(t.TempDir(), "metadata.db"))
+	require.NoError(t, err)
+	t.Cleanup(func() { require.NoError(t, s.Close()) })
+	si, _ := s.Get("record")
+	md := &cacheMetadata{si: si}
+	require.NoError(t, md.queueSize(sizeUnknown))
+	require.NoError(t, md.commitMetadata())
+	var wg sync.WaitGroup
+	errs := make(chan error, 16)
+	for range 16 {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			handle, _ := s.Get("record")
+			m := &cacheMetadata{si: handle}
+			if err := m.queueSize(sizeUnknown); err != nil {
+				errs <- err
+				return
+			}
+			errs <- m.commitMetadata()
+		}()
+	}
+	wg.Wait()
+	close(errs)
+	for err := range errs {
+		require.NoError(t, err)
+	}
+	fresh, _ := s.Get("record")
+	require.Equal(t, sizeUnknown, (&cacheMetadata{si: fresh}).getSize())
+}
