+package metadata
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	bolt "go.etcd.io/bbolt"
+)
+
+func TestQueueValueIfChangedRepairAndErrors(t *testing.T) {
+	for _, kind := range []string{"missing", "indexed", "invalid", "bucket", "empty-key", "nil", "indexed-target"} {
+		t.Run(kind, func(t *testing.T) {
+			s, err := NewStore(filepath.Join(t.TempDir(), "metadata.db"))
+			require.NoError(t, err)
+			t.Cleanup(func() { require.NoError(t, s.Close()) })
+			si, _ := s.Get("record")
+			desired, err := NewValue(int64(-1))
+			require.NoError(t, err)
+			key := "size"
+			switch kind {
+			case "indexed":
+				old, err := NewValue(int64(-1))
+				require.NoError(t, err)
+				old.Index = "old"
+				require.NoError(t, si.Update(func(b *bolt.Bucket) error { return si.SetValue(b, key, old) }))
+			case "invalid":
+				require.NoError(t, si.Update(func(b *bolt.Bucket) error { return b.Put([]byte(key), []byte("invalid")) }))
+			case "bucket":
+				require.NoError(t, si.Update(func(b *bolt.Bucket) error { _, err := b.CreateBucket([]byte(key)); return err }))
+			case "empty-key":
+				key = ""
+			case "nil":
+				desired = nil
+			case "indexed-target":
+				desired.Index = "new"
+			}
+			si.QueueValueIfChanged(key, desired)
+			err = si.Commit()
+			switch kind {
+			case "invalid", "bucket", "empty-key":
+				require.Error(t, err)
+				require.Len(t, si.queue, 1)
+			default:
+				require.NoError(t, err)
+				require.Empty(t, si.queue)
+				fresh, _ := s.Get("record")
+				require.Equal(t, desired, fresh.Get(key))
+				found, err := s.Probe("old")
+				require.NoError(t, err)
+				require.False(t, found)
+				if kind == "indexed-target" {
+					found, err := s.Probe("new")
+					require.NoError(t, err)
+					require.True(t, found)
+				}
+			}
+		})
+	}
+}
