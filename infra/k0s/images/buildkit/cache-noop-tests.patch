+func TestLinkBlobMatchingLabelsNoop(t *testing.T) {
+	ctx, ref, co, lm, cs, desc := compressionNoopFixture(t, true, true)
+	info, err := co.cs.Info(ctx, desc.Digest)
+	require.NoError(t, err)
+	if info.Labels == nil {
+		info.Labels = make(map[string]string)
+	}
+	info.Labels["example.unrelated"] = "retained"
+	_, err = co.cs.Update(ctx, info, "labels.example.unrelated")
+	require.NoError(t, err)
+	require.NoError(t, ref.linkBlob(ctx, desc))
+	before := cs.updates.Load()
+	beforeResources := lm.variantResources.Load()
+	require.NoError(t, ref.linkBlob(ctx, desc))
+	t.Logf("one repeated linkBlob: content updates=%d persistent AddResource=%d", cs.updates.Load()-before, lm.variantResources.Load()-beforeResources)
+	require.Equal(t, before, cs.updates.Load(), "matching targeted labels must not cause another content update")
+	info, err = co.cs.Info(ctx, desc.Digest)
+	require.NoError(t, err)
+	require.Equal(t, "retained", info.Labels["example.unrelated"])
+	require.Equal(t, desc.Digest.String(), info.Labels[blobVariantGCLabel+desc.Digest.String()])
+}
+
+func TestEnsureCompressionLeaseAndConversion(t *testing.T) {
+	ctx, ref, co, lm, cs, original := compressionNoopFixture(t, false, true)
+	withoutLease := namespaces.WithNamespace(t.Context(), "buildkit-test")
+	require.ErrorContains(t, ensureCompression(withoutLease, ref, compression.New(compression.Uncompressed), nil), "missing lease requirement")
+	require.Zero(t, lm.temporary.Load())
+	require.NoError(t, ensureCompression(ctx, ref, compression.New(compression.Zstd).SetForce(true), nil))
+	require.EqualValues(t, 1, lm.temporary.Load())
+	select {
+	case <-lm.discarded:
+	case <-time.After(5 * time.Second):
+		t.Fatal("conversion temporary lease was not discarded after adoption")
+	}
+	converted, err := ref.getBlobWithCompression(ctx, compression.Zstd)
+	require.NoError(t, err)
+	require.NotEqual(t, original.Digest, converted.Digest)
+	caller, _ := leases.FromContext(ctx)
+	resources, err := co.lm.ListResources(ctx, leases.Lease{ID: caller})
+	require.NoError(t, err)
+	require.Contains(t, resources, leases.Resource{Type: "content", ID: converted.Digest.String()})
+	before := cs.updates.Load()
+	require.NoError(t, ensureCompression(ctx, ref, compression.New(compression.Zstd).SetForce(true), nil))
+	require.EqualValues(t, 1, lm.temporary.Load(), "existing requested variant must not allocate another temporary lease")
+	require.Equal(t, before, cs.updates.Load())
+	for _, pair := range [][2]digest.Digest{{original.Digest, converted.Digest}, {converted.Digest, original.Digest}} {
+		info, err := co.cs.Info(ctx, pair[0])
+		require.NoError(t, err)
+		key := blobVariantGCLabel + pair[1].String()
+		require.Equal(t, pair[1].String(), info.Labels[key])
+		delete(info.Labels, key)
+		_, err = co.cs.Update(ctx, info, "labels."+key)
+		require.NoError(t, err)
+		require.NoError(t, ref.linkBlob(ctx, converted))
+		info, err = co.cs.Info(ctx, pair[0])
+		require.NoError(t, err)
+		require.Equal(t, pair[1].String(), info.Labels[key])
+	}
+	// Drop caller retention; persistent variant links must survive native GC.
+	require.NoError(t, co.lm.Delete(ctx, leases.Lease{ID: caller}))
+	_, err = ref.cm.GarbageCollect(ctx)
+	require.NoError(t, err)
+	for _, dgst := range []digest.Digest{original.Digest, converted.Digest} {
+		_, err := co.cs.Info(ctx, dgst)
+		require.NoError(t, err)
+	}
+}
+
+func TestEnsureCompressionFailures(t *testing.T) {
+	t.Run("conversion discards temporary lease", func(t *testing.T) {
+		ctx, ref, _, lm, cs, _ := compressionNoopFixture(t, false, true)
+		failure := errors.New("native writer unavailable")
+		cs.writeErr = failure
+		require.ErrorIs(t, ensureCompression(ctx, ref, compression.New(compression.Zstd), nil), failure)
+		require.EqualValues(t, 1, lm.temporary.Load())
+		select {
+		case <-lm.discarded:
+		case <-time.After(5 * time.Second):
+			t.Fatal("failed conversion temporary lease was not discarded")
+		}
+	})
+	t.Run("matching repair propagates update failure", func(t *testing.T) {
+		ctx, ref, _, lm, cs, _ := compressionNoopFixture(t, true, true)
+		failure := errors.New("native label update unavailable")
+		cs.updateErr = failure
+		require.ErrorIs(t, ensureCompression(ctx, ref, compression.New(compression.Zstd), nil), failure)
+		require.Zero(t, lm.temporary.Load())
+	})
+}
