+// QueueValueIfChanged avoids a write only for an identical durable, unindexed value.
+func (s *StorageItem) QueueValueIfChanged(key string, v *Value) {
+	s.Queue(func(b *bolt.Bucket) error {
+		s.vmu.Lock()
+		defer s.vmu.Unlock()
+		if v != nil && v.Index == "" {
+			dt, err := json.Marshal(v)
+			if err != nil {
+				return errors.WithStack(err)
+			}
+			if bytes.Equal(b.Get([]byte(key)), dt) {
+				s.values[key] = v
+				return errNoChange
+			}
+		}
+		return s.setValue(b, key, v)
+	})
+}
