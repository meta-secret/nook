#!/bin/sh
set -eu

backing_dir=/var/lib/nook-buildkit-backing
backing_file="$backing_dir/buildkit.ext4"
state_dir=/var/lib/buildkit
loop_device=/dev/loop0

mkdir -p "$backing_dir" "$state_dir"
if [ ! -b "$loop_device" ]; then
  mknod -m 0660 "$loop_device" b 7 0
fi
losetup -d "$loop_device" 2>/dev/null || true

if [ ! -f "$backing_file" ]; then
  echo "Private ARC BuildKit state was not prepared" >&2
  exit 1
fi

actual_size="$(stat -c %s "$backing_file")"
expected_bytes="${NOOK_BUILDKIT_STATE_IMAGE_BYTES:-51539607552}"
if [ "$actual_size" != "$expected_bytes" ]; then
  echo "Private ARC BuildKit state must be $expected_bytes bytes (got $actual_size)" >&2
  exit 1
fi

losetup "$loop_device" "$backing_file"

mount -t ext4 -o noatime "$loop_device" "$state_dir"

exec buildkitd "$@"
