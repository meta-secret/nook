#!/bin/sh
set -eu

request_dir=/var/lib/nook-buildkit-requests
pod_uid="${POD_UID:-}"

case "$pod_uid" in
  ????????-????-????-????-????????????) ;;
  *)
    echo "ARC BuildKit state requires a Kubernetes Pod UID" >&2
    exit 2
    ;;
esac

request_lane="$request_dir/$pod_uid"
request_file="$request_lane/request"
request_temp="$request_file.tmp"
ready_file="$request_lane/ready"

test -d "$request_dir"
if test -L "$request_lane"; then
  echo "ARC BuildKit request lane must not be a symlink" >&2
  exit 2
fi
mkdir -p "$request_lane"
chmod 0700 "$request_lane"
test "$(stat -c '%F:%u:%g:%a' "$request_lane")" = "directory:0:0:700"
rm -f "$ready_file"
printf '%s\n' "$pod_uid" > "$request_temp"
mv "$request_temp" "$request_file"

deadline=$(($(date +%s) + 240))
while test "$(date +%s)" -lt "$deadline"; do
  if test -f "$ready_file"; then
    rm -f "$ready_file"
    echo "Prepared private reflinked BuildKit state for Pod $pod_uid"
    exit 0
  fi
  sleep 1
done

echo "Timed out waiting for private BuildKit state for Pod $pod_uid" >&2
exit 1
