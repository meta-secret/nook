#!/usr/bin/env bash
set -euo pipefail

controller_target="${1:?controller SSH target is required}"
inventory_file="$(mktemp)"
reachable_file="$(mktemp)"
trap 'rm -f "$inventory_file" "$reachable_file"' EXIT

ssh -o BatchMode=yes "$controller_target" 'bash -s' > "$inventory_file" <<'REMOTE'
set -euo pipefail
kubectl() { sudo -n k0s kubectl "$@"; }
compute_nodes="$(kubectl get nodes -l nook.nokey.sh/node-role=compute -o json)"
if test "$(printf '%s' "$compute_nodes" | jq '.items | length')" = 0; then
  printf 'empty\n'
  exit 0
fi
controller_public_ip="$(ip -4 route get 1.1.1.1 | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }')"
controller_public_key="$(sudo -n cat /etc/wireguard/nook-public.key)"
controller_node="$(kubectl get nodes -l node.k0sproject.io/role=control-plane -o jsonpath='{.items[0].metadata.name}')"
controller_pod_cidr="$(kubectl get node "$controller_node" -o jsonpath='{.spec.podCIDR}')"
printf 'controller\t%s\t%s\t%s\n' \
  "$controller_public_ip" "$controller_public_key" "$controller_pod_cidr"
printf '%s' "$compute_nodes" |
  jq -r '.items | sort_by(.metadata.name)[] |
    [.metadata.name,
     (.status.addresses[] | select(.type == "InternalIP") | .address),
     .spec.podCIDR,
     .metadata.annotations["nook.nokey.sh/ssh-target"]] | @tsv' |
  while IFS=$'\t' read -r node_name address pod_cidr ssh_target; do
    peer_file="/etc/wireguard/nook-peers/$address.conf"
    endpoint_file="/etc/nftables.d/nook-k0s-mesh-endpoints/$address.endpoint"
    test "$(sudo -n stat -c '%F:%u:%g:%h' -- "$peer_file")" = "regular file:0:0:1"
    public_key="$(sudo -n sed -n 's/^PublicKey = //p' "$peer_file")"
    endpoint="$(sudo -n sed -n 's/^Endpoint = //p' "$peer_file")"
    if test -z "$endpoint"; then
      endpoint="$(sudo -n wg show wg-nook endpoints | awk -v key="$public_key" '$1 == key { print $2 }')"
    fi
    endpoint_mode="$(sudo -n cat "$endpoint_file")"
    case "$endpoint_mode" in direct:*|roaming) ;; *) exit 2 ;; esac
    if test -z "$endpoint" && test "$endpoint_mode" = roaming; then
      endpoint=unavailable
    fi
    endpoint_host="${endpoint%:*}"
    endpoint_port="${endpoint##*:}"
    [[ "$node_name" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]]
    [[ "$address" =~ ^10\.202\.0\.([2-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-4])$ ]]
    [[ "$pod_cidr" =~ ^10\.244\.[0-9]{1,3}\.0/24$ ]]
    [[ "$public_key" =~ ^[A-Za-z0-9+/]{43}=$ ]]
    if test "$endpoint" != unavailable; then
      [[ "$endpoint_host" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
      [[ "$endpoint_port" =~ ^[0-9]{1,5}$ ]]
      ((endpoint_port >= 1 && endpoint_port <= 65535))
    fi
    [[ "$ssh_target" =~ ^[a-z_][a-z0-9_-]*@10\.202\.0\.[0-9]{1,3}$ ]]
    ssh_host="${ssh_target#*@}"
    test "$ssh_host" = "$address"
    printf 'worker\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$node_name" "$address" "$pod_cidr" "$public_key" "$endpoint" "$ssh_target"
  done
REMOTE
inventory="$(cat "$inventory_file")"
controller_line="$(printf '%s\n' "$inventory" | sed -n '1p')"
if test "$controller_line" = empty; then
  echo "No registered compute workers require direct mesh reconciliation"
  exit 0
fi
IFS=$'\t' read -r kind controller_public_ip controller_public_key controller_pod_cidr <<<"$controller_line"
test "$kind" = controller
[[ "$controller_public_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
[[ "$controller_public_key" =~ ^[A-Za-z0-9+/]{43}=$ ]]
[[ "$controller_pod_cidr" =~ ^10\.244\.[0-9]{1,3}\.0/24$ ]]
workers="$(printf '%s\n' "$inventory" | sed -n '2,$p')"
if test -z "$workers"; then
  echo "No registered compute workers require direct mesh reconciliation"
  exit 0
fi
set_mesh_pending() {
  local node_name="$1"
  ssh -n -o BatchMode=yes "$controller_target" \
    "sudo -n k0s kubectl taint node '$node_name' nook.nokey.sh/mesh=pending:NoSchedule --overwrite" \
    >/dev/null
}

clear_mesh_pending() {
  local node_name="$1"
  ssh -o BatchMode=yes "$controller_target" bash -s -- "$node_name" <<'REMOTE'
set -euo pipefail
node_name="$1"
node="$(sudo -n k0s kubectl get node "$node_name" -o json)"
if printf '%s' "$node" | jq -e \
  '(.spec.taints // []) | any(.key == "nook.nokey.sh/mesh" and .effect == "NoSchedule")' \
  >/dev/null; then
  sudo -n k0s kubectl taint node "$node_name" nook.nokey.sh/mesh:NoSchedule- \
    >/dev/null
fi
REMOTE
}

while IFS=$'\t' read -r worker_kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$worker_kind" = worker
  set_mesh_pending "$node_name"
done <<<"$workers"

while IFS=$'\t' read -r worker_kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$worker_kind" = worker
  if test "$endpoint" = unavailable; then
    set_mesh_pending "$node_name"
    echo "Deferred offline roaming worker $address ($ssh_target)" >&2
    continue
  fi
  if ! ssh -n -o BatchMode=yes -o ConnectTimeout=5 \
    -J "$controller_target" "$ssh_target" true; then
    set_mesh_pending "$node_name"
    echo "Deferred offline worker $address ($ssh_target)" >&2
    continue
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$worker_kind" "$node_name" "$address" "$pod_cidr" "$public_key" "$endpoint" "$ssh_target" \
    >> "$reachable_file"
done <<<"$workers"

reachable_workers="$(cat "$reachable_file")"
if test -z "$reachable_workers"; then
  echo "No reachable compute workers require direct mesh verification"
  exit 0
fi
inventory_payload="$(printf '%s\n' "$reachable_workers" | base64 | tr -d '\n')"

while IFS=$'\t' read -r worker_kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$worker_kind" = worker
  printf -v worker_command 'bash -s -- %q %q %q %q %q' \
    "$address" "$controller_public_ip" "$controller_public_key" \
    "$controller_pod_cidr" "$inventory_payload"
  ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new \
    -J "$controller_target" "$ssh_target" "$worker_command" <<'REMOTE'
set -euo pipefail
local_address="$1"
controller_public_ip="$2"
controller_public_key="$3"
controller_pod_cidr="$4"
inventory_payload="$5"
private_key="$(sudo -n cat /etc/wireguard/nook-private.key)"
config="$(mktemp)"
stripped="$(mktemp)"
live="$(mktemp)"
cleanup() {
  private_key=
  rm -f "$config" "$stripped" "$live"
  sudo -n rm -f /etc/wireguard/.nook-syncconf
}
trap cleanup EXIT
printf '%s\n' \
  '[Interface]' \
  "Address = $local_address/24" \
  'ListenPort = 51820' \
  "PrivateKey = $private_key" \
  '' \
  '[Peer]' \
  "PublicKey = $controller_public_key" \
  "Endpoint = $controller_public_ip:51820" \
  "AllowedIPs = 10.202.0.1/32,10.201.0.1/32,$controller_pod_cidr" \
  'PersistentKeepalive = 25' > "$config"
while IFS=$'\t' read -r kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$kind" = worker
  test "$address" != "$local_address" || continue
  printf '%s\n' \
    '' \
    '[Peer]' \
    "PublicKey = $public_key" \
    "Endpoint = $endpoint" \
    "AllowedIPs = $address/32,$pod_cidr" \
    'PersistentKeepalive = 25' >> "$config"
done < <(printf '%s' "$inventory_payload" | base64 -d)
sudo -n install -m 0600 "$config" /etc/wireguard/wg-nook.conf
private_key=
sudo -n wg-quick strip wg-nook > "$stripped"
sudo -n install -m 0600 "$stripped" /etc/wireguard/.nook-syncconf
sudo -n wg syncconf wg-nook /etc/wireguard/.nook-syncconf
sudo -n rm -f /etc/wireguard/.nook-syncconf
sudo -n ip route replace "$controller_pod_cidr" dev wg-nook
while IFS=$'\t' read -r kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$kind" = worker
  test "$address" != "$local_address" || continue
  sudo -n ip route replace "$pod_cidr" dev wg-nook
done < <(printf '%s' "$inventory_payload" | base64 -d)
escaped_controller_ip="${controller_public_ip//./\\.}"
if sudo -n nft list table inet bynull_filter >/dev/null 2>&1; then
  sudo -n sed -E -i \
    -e "s/ip saddr $escaped_controller_ip udp dport 51820 accept([[:space:]]*)$/udp dport 51820 accept comment \"nook k0s worker wireguard\"/" \
    -e 's/ip saddr ([0-9]{1,3}\.){3}[0-9]{1,3} udp dport 51820 accept comment "nook k0s worker wireguard"/udp dport 51820 accept comment "nook k0s worker wireguard"/' \
    /etc/nftables.conf
  sudo -n nft --handle list chain inet bynull_filter input |
    awk -v controller_ip="$controller_public_ip" '
      /udp dport 51820 accept.*comment "nook k0s worker wireguard"/ ||
      $0 ~ "ip saddr " controller_ip " udp dport 51820 accept([[:space:]]|$)" {
        print "delete rule inet bynull_filter input handle " $NF
      }' > "$live"
  printf '%s\n' \
    'add rule inet bynull_filter input udp dport 51820 accept comment "nook k0s worker wireguard"' >> "$live"
  sudo -n nft --check --file "$live"
  sudo -n nft --file "$live"
else
  sudo -n nft --json list chain ip filter INPUT |
    jq -e '.nftables[] | select(.chain.name == "INPUT") | .chain.policy == "accept"' \
    >/dev/null
fi
REMOTE
done <<<"$reachable_workers"

while IFS=$'\t' read -r source_kind source_node source_address source_pod_cidr source_key source_endpoint source_target; do
  test "$source_kind" = worker
  while IFS=$'\t' read -r target_kind target_node target_address target_pod_cidr target_key target_endpoint target_target; do
    test "$target_kind" = worker
    test "$source_address" != "$target_address" || continue
    ssh -n -o BatchMode=yes -J "$controller_target" "$source_target" \
      "ping -c 1 -W 3 '$target_address' >/dev/null"
  done <<<"$reachable_workers"
done <<<"$reachable_workers"
while IFS=$'\t' read -r worker_kind node_name address pod_cidr public_key endpoint ssh_target; do
  test "$worker_kind" = worker
  clear_mesh_pending "$node_name"
done <<<"$reachable_workers"
echo "Authenticated direct worker mesh is healthy"
