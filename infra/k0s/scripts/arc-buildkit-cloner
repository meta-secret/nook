#!/usr/bin/env bash
set -euo pipefail

pool_dir="${NOOK_ARC_BUILDKIT_POOL:-/var/lib/nook-arc-buildkit/pool}"
seed_file="$pool_dir/seed/buildkit.ext4"
request_dir="$pool_dir/requests"
jobs_dir="$pool_dir/jobs"
runtime_dir="$pool_dir/runtime"
seed_lock="$pool_dir/.seed.lock"
github_token_file="${NOOK_ARC_GITHUB_TOKEN_FILE:-/etc/nook/arc-cache-verifier-token}"
github_repository="${NOOK_ARC_GITHUB_REPOSITORY:-meta-secret/nook}"
pod_root="${NOOK_K0S_POD_ROOT:-/var/lib/k0s/kubelet/pods}"
job_exclusive_limit="${NOOK_ARC_BUILDKIT_JOB_EXCLUSIVE_LIMIT:-32G}"
last_prune=0
last_sandbox_refresh=-1

mkdir -p "$request_dir" "$jobs_dir" "$runtime_dir"
chmod 0700 "$runtime_dir"
test -f "$seed_file"
test -s "$github_token_file"

valid_uid() {
  [[ "$1" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]]
}

delete_job_dir() {
  local job_dir="$1"
  local pod_uid
  pod_uid="$(basename "$job_dir")"
  if btrfs subvolume show "$job_dir" >/dev/null 2>&1; then
    btrfs subvolume delete "$job_dir" >/dev/null
  else
    rm -rf -- "$job_dir"
  fi
  rm -f -- "$runtime_dir/$pod_uid.sandbox" "$runtime_dir/$pod_uid.retain" \
    "$request_dir/$pod_uid.intent" "$request_dir/$pod_uid.intent.next" \
    "$request_dir/$pod_uid.candidate" "$request_dir/$pod_uid.candidate.next" \
    "$request_dir/$pod_uid.promote" "$request_dir/$pod_uid.promote.next"
}

valid_job_marker() {
  local pod_uid="$1" suffix="$2" request request_value
  request="$request_dir/$pod_uid.$suffix"
  test -e "$request" || return 1
  if test -L "$request" ||
     test "$(stat -c '%F:%u:%g:%h' -- "$request" 2>/dev/null || true)" != \
       "regular file:0:0:1"; then
    rm -f -- "$request"
    return 1
  fi
  request_value="$(tr -d '\r\n' < "$request")"
  if test "$request_value" != "$pod_uid"; then
    rm -f -- "$request"
    return 1
  fi
}

promotion_requested() {
  valid_job_marker "$1" promote
}

promotion_intended() {
  local pod_uid="$1" intent intent_value intent_uid pod_name run_id run_attempt
  local head_sha trailing
  intent="$request_dir/$pod_uid.intent"
  test -e "$intent" || return 1
  if test -L "$intent" ||
     test "$(stat -c '%F:%u:%g:%h' -- "$intent" 2>/dev/null || true)" != \
       "regular file:0:0:1"; then
    rm -f -- "$intent"
    return 1
  fi
  intent_value="$(tr -d '\r\n' < "$intent")"
  IFS=: read -r intent_uid pod_name run_id run_attempt head_sha trailing <<EOF
$intent_value
EOF
  test -z "$trailing" && test "$intent_uid" = "$pod_uid" &&
    [[ "$pod_name" =~ ^[a-z0-9-]+$ ]] &&
    [[ "$run_id" =~ ^[0-9]+$ ]] &&
    [[ "$run_attempt" =~ ^[0-9]+$ ]] &&
    [[ "$head_sha" =~ ^[0-9a-f]{40}$ ]]
}

github_get() {
  local endpoint="$1" token
  token="$(tr -d '\r\n' < "$github_token_file")"
  [[ "$token" =~ ^[A-Za-z0-9_]+$ ]]
  {
    printf 'header = "Authorization: Bearer %s"\n' "$token"
    printf 'header = "Accept: application/vnd.github+json"\n'
    printf 'header = "X-GitHub-Api-Version: 2022-11-28"\n'
  } | curl --config - --fail --silent --show-error \
    --connect-timeout 5 --max-time 15 \
    "https://api.github.com/repos/$github_repository/$endpoint"
}

promotion_job_conclusion() {
  local pod_uid="$1" intent_value intent_uid pod_name run_id run_attempt
  local head_sha trailing jobs
  intent_value="$(tr -d '\r\n' < "$request_dir/$pod_uid.intent")"
  IFS=: read -r intent_uid pod_name run_id run_attempt head_sha trailing <<EOF
$intent_value
EOF
  jobs="$(github_get "actions/runs/$run_id/attempts/$run_attempt/jobs?per_page=100")" || return 1
  printf '%s' "$jobs" | jq -r --arg runner "$pod_name" \
    '[.jobs[]? | select(.runner_name == $runner)][0].conclusion // empty'
}

verify_promotion_candidates() {
  local candidate candidate_value pod_uid candidate_uid pod_name run_id
  local run_attempt head_sha trailing job_dir run jobs intent_next
  shopt -s nullglob
  for candidate in "$request_dir"/*.candidate; do
    pod_uid="$(basename "$candidate" .candidate)"
    if ! valid_uid "$pod_uid" || test -L "$candidate" ||
       test "$(stat -c '%F:%u:%g:%h' -- "$candidate" 2>/dev/null || true)" != \
         "regular file:0:0:1"; then
      rm -f -- "$candidate"
      continue
    fi
    candidate_value="$(tr -d '\r\n' < "$candidate")"
    IFS=: read -r candidate_uid pod_name run_id run_attempt head_sha trailing <<EOF
$candidate_value
EOF
    if ! test -z "$trailing" || ! test "$candidate_uid" = "$pod_uid" ||
       ! [[ "$pod_name" =~ ^[a-z0-9-]+$ ]] ||
       ! [[ "$run_id" =~ ^[0-9]+$ ]] ||
       ! [[ "$run_attempt" =~ ^[0-9]+$ ]] ||
       ! [[ "$head_sha" =~ ^[0-9a-f]{40}$ ]]; then
      rm -f -- "$candidate"
      continue
    fi
    job_dir="$jobs_dir/$pod_uid"
    if ! test -d "$job_dir"; then
      rm -f -- "$candidate"
      continue
    fi
    if ! run="$(github_get "actions/runs/$run_id")"; then
      rm -f -- "$candidate"
      continue
    fi
    if ! printf '%s' "$run" | jq -e \
      --arg repository "$github_repository" --arg sha "$head_sha" \
      '.event == "push" and .head_branch == "main" and .head_sha == $sha and
       .head_repository.full_name == $repository' >/dev/null; then
      rm -f -- "$candidate"
      continue
    fi
    if ! jobs="$(github_get "actions/runs/$run_id/attempts/$run_attempt/jobs?per_page=100")"; then
      rm -f -- "$candidate"
      continue
    fi
    if ! printf '%s' "$jobs" | jq -e --arg runner "$pod_name" \
      'any(.jobs[]?; .runner_name == $runner and .status == "in_progress" and .conclusion == null)' \
      >/dev/null; then
      rm -f -- "$candidate"
      continue
    fi
    intent_next="$request_dir/$pod_uid.intent.next"
    printf '%s\n' "$candidate_value" > "$intent_next"
    chmod 0600 "$intent_next"
    mv "$intent_next" "$request_dir/$pod_uid.intent"
    rm -f -- "$candidate"
  done
}

promotion_intent_expired() {
  local pod_uid="$1" intent
  intent="$request_dir/$pod_uid.intent"
  test -n "$(find "$intent" -mmin +2 -print -quit 2>/dev/null)"
}

promotion_requests_pending() {
  local request pod_uid job_dir
  shopt -s nullglob
  for request in "$request_dir"/*.promote; do
    pod_uid="$(basename "$request" .promote)"
    if ! valid_uid "$pod_uid"; then
      rm -f -- "$request"
      continue
    fi
    job_dir="$jobs_dir/$pod_uid"
    if ! test -d "$job_dir" || ! promotion_requested "$pod_uid"; then
      rm -f -- "$request"
      continue
    fi
    if test -n "$(find "$request" -mmin +2 -print -quit 2>/dev/null)"; then
      echo "Abandoning expired ARC promotion barrier for $pod_uid" >&2
      rm -f -- "$request"
      continue
    fi
    return 0
  done
  return 1
}

promotion_intents_pending() {
  local intent pod_uid job_dir
  shopt -s nullglob
  for intent in "$request_dir"/*.intent; do
    pod_uid="$(basename "$intent" .intent)"
    if ! valid_uid "$pod_uid"; then
      rm -f -- "$intent"
      continue
    fi
    job_dir="$jobs_dir/$pod_uid"
    if ! test -d "$job_dir" || ! promotion_intended "$pod_uid"; then
      rm -f -- "$intent"
      continue
    fi
    if promotion_intent_expired "$pod_uid"; then
      echo "Abandoning expired ARC promotion intent for $pod_uid" >&2
      rm -f -- "$intent"
      continue
    fi
    return 0
  done
  return 1
}

promotion_barrier_pending() {
  promotion_requests_pending || promotion_intents_pending
}

promote_job_dir() {
  local job_dir="$1" pod_uid job_file job_generation generation_size
  local expected_generation current_generation seed_next
  pod_uid="$(basename "$job_dir")"
  job_file="$job_dir/buildkit.ext4"
  job_generation="$job_dir/.seed-generation"
  seed_next="$pool_dir/seed/buildkit.ext4.next.$pod_uid"

  generation_size="$(stat -c %s -- "$job_generation" 2>/dev/null || true)"
  if test -L "$job_generation" ||
     test "$(stat -c '%F:%u:%g:%h' -- "$job_generation" 2>/dev/null || true)" != \
       "regular file:0:0:1" ||
     test "$generation_size" -lt 8 ||
     test "$generation_size" -gt 128 ||
     ! grep -Eq '^[0-9]+:[0-9]+:[0-9]+:[0-9]+$' "$job_generation"; then
    echo "Refusing ARC promotion for $pod_uid: invalid seed generation" >&2
    return 1
  fi
  if test -L "$job_file" ||
     test "$(stat -c '%F:%u:%g:%h:%s' -- "$job_file" 2>/dev/null || true)" != \
       "regular file:0:0:1:34359738368"; then
    echo "Refusing ARC promotion for $pod_uid: invalid BuildKit state" >&2
    return 1
  fi

  (
    flock -x 9
    expected_generation="$(cat "$job_generation")"
    current_generation="$(stat -c '%i:%s:%Y:%Z' "$seed_file")"
    if test "$current_generation" != "$expected_generation"; then
      echo "Skipping stale ARC promotion for $pod_uid"
      exit 0
    fi
    rm -f -- "$seed_next"
    if ! cp --reflink=always --sparse=auto "$job_file" "$seed_next"; then
      rm -f -- "$seed_next"
      echo "Refusing ARC promotion for $pod_uid: seed reflink failed" >&2
      exit 1
    fi
    if ! mv "$seed_next" "$seed_file"; then
      rm -f -- "$seed_next"
      echo "Refusing ARC promotion for $pod_uid: atomic seed replacement failed" >&2
      exit 1
    fi
    echo "Promoted ARC BuildKit state for $pod_uid"
  ) 9> "$seed_lock"
}

record_sandbox_id() {
  local pod_uid="$1"
  local existing_sandbox_id="" sandbox_id sandbox_marker temporary
  sandbox_id="$(
    k0s ctr --namespace k8s.io containers list -q \
      "labels.\"io.kubernetes.pod.uid\"==$pod_uid,labels.\"io.cri-containerd.kind\"==sandbox"
  )"
  [[ "$sandbox_id" =~ ^[0-9a-f]{64}$ ]] || return 1
  sandbox_marker="$runtime_dir/$pod_uid.sandbox"
  if test -f "$sandbox_marker" && ! test -L "$sandbox_marker"; then
    existing_sandbox_id="$(tr -d '\r\n' < "$sandbox_marker")"
  fi
  test "$existing_sandbox_id" = "$sandbox_id" && return 0
  temporary="$sandbox_marker.tmp"
  printf '%s\n' "$sandbox_id" > "$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$sandbox_marker"
}

record_active_sandboxes() {
  local job_dir pod_uid
  while IFS= read -r -d '' job_dir; do
    pod_uid="$(basename "$job_dir")"
    valid_uid "$pod_uid" || continue
    record_sandbox_id "$pod_uid" || true
  done < <(
    find "$jobs_dir" -mindepth 1 -maxdepth 1 -type d -print0
  )
}

retention_active() {
  local now pod_uid="$1" retain_expiry retain_marker
  retain_marker="$runtime_dir/$pod_uid.retain"
  if test -L "$retain_marker" ||
     test "$(stat -c '%F:%u:%g:%h' -- "$retain_marker" 2>/dev/null || true)" != \
       "regular file:0:0:1"; then
    rm -f -- "$retain_marker"
    return 1
  fi
  retain_expiry="$(tr -d '\r\n' < "$retain_marker")"
  [[ "$retain_expiry" =~ ^[0-9]+$ ]] || {
    rm -f -- "$retain_marker"
    return 1
  }
  now="$(date +%s)"
  if (( retain_expiry > now && retain_expiry <= now + 1800 )); then
    return 0
  fi
  rm -f -- "$retain_marker"
  return 1
}

request_expired() {
  local container_list pod_uid="$1" request="$2"
  test -n "$(find "$request" -mmin +5 -print -quit)" || return 1
  test ! -e "$pod_root/$pod_uid" || return 1
  if ! container_list="$(
    k0s ctr --namespace k8s.io containers list -q \
      "labels.\"io.kubernetes.pod.uid\"==$pod_uid"
  )"; then
    return 1
  fi
  test -z "$container_list"
}

clone_requests() {
  local request pod_uid request_value job_dir temporary
  promotion_barrier_pending && return 0
  shopt -s nullglob
  for request in "$request_dir"/*.request; do
    test -f "$request" || continue
    test ! -L "$request" || {
      rm -f -- "$request"
      continue
    }
    pod_uid="$(basename "$request" .request)"
    if ! valid_uid "$pod_uid"; then
      rm -f -- "$request"
      continue
    fi
    request_value="$(tr -d '\r\n' < "$request")"
    if test "$request_value" != "$pod_uid"; then
      rm -f -- "$request"
      continue
    fi

    job_dir="$jobs_dir/$pod_uid"
    if test -L "$job_dir"; then
      rm -f -- "$request"
      continue
    fi
    if ! record_sandbox_id "$pod_uid"; then
      if request_expired "$pod_uid" "$request"; then
        rm -f -- "$request" "$request_dir/$pod_uid.ready" \
          "$runtime_dir/$pod_uid.sandbox"
      fi
      continue
    fi
    if ! test -d "$job_dir"; then
      btrfs subvolume create "$job_dir" >/dev/null
    fi
    chmod 0755 "$job_dir"
    btrfs qgroup limit -e "$job_exclusive_limit" "$job_dir"
    if test -f "$job_dir/.ready" &&
       test -f "$job_dir/buildkit.ext4" &&
       test -f "$job_dir/.seed-generation"; then
      if record_sandbox_id "$pod_uid"; then
        touch "$request_dir/$pod_uid.ready"
        rm -f -- "$request"
      fi
      continue
    fi

    temporary="$job_dir/buildkit.ext4.tmp"
    rm -f -- "$temporary"
    (
      flock -s 9
      cp --reflink=always --sparse=auto "$seed_file" "$temporary"
      stat -c '%i:%s:%Y:%Z' "$seed_file" > "$job_dir/.seed-generation"
      chmod 0400 "$job_dir/.seed-generation"
    ) 9> "$seed_lock"
    mv "$temporary" "$job_dir/buildkit.ext4"
    touch "$job_dir/.ready"
    if ! record_sandbox_id "$pod_uid"; then
      delete_job_dir "$job_dir"
      continue
    fi
    touch "$request_dir/$pod_uid.ready"
    rm -f -- "$request"
  done
}

prune_stale_jobs() {
  local command_line command_line_file conclusion container_list job_dir pod_uid
  local sandbox_id sandbox_marker task_list
  while IFS= read -r -d '' job_dir; do
    pod_uid="$(basename "$job_dir")"
    valid_uid "$pod_uid" || continue
    test ! -e "$pod_root/$pod_uid" || continue
    if ! container_list="$(
      k0s ctr --namespace k8s.io containers list -q \
        "labels.\"io.kubernetes.pod.uid\"==$pod_uid" 2>/dev/null
    )"; then
      continue
    fi
    if test -n "$container_list"; then
      continue
    fi
    sandbox_marker="$runtime_dir/$pod_uid.sandbox"
    if test -L "$sandbox_marker" ||
       test "$(stat -c '%F:%u:%g:%h' -- "$sandbox_marker" 2>/dev/null || true)" != \
         "regular file:0:0:1"; then
      test ! -e "$request_dir/$pod_uid.request" || continue
      for command_line_file in /proc/[0-9]*/cmdline; do
        test -r "$command_line_file" || continue
        command_line="$(tr '\0' ' ' 2>/dev/null < "$command_line_file" || true)"
        case "$command_line" in
          *containerd-shim-kata-v2*) continue 2 ;;
        esac
      done
      if promotion_intended "$pod_uid"; then
        if ! promotion_intent_expired "$pod_uid"; then
          conclusion="$(promotion_job_conclusion "$pod_uid" || true)"
          case "$conclusion" in
            success) promote_job_dir "$job_dir" || true ;;
            cancelled|failure|neutral|skipped|stale|timed_out) ;;
            *) continue ;;
          esac
        fi
        rm -f -- "$request_dir/$pod_uid.intent"
      elif promotion_requested "$pod_uid"; then
        promote_job_dir "$job_dir" || true
      elif retention_active "$pod_uid"; then
        continue
      fi
      delete_job_dir "$job_dir"
      continue
    fi
    sandbox_id="$(tr -d '\r\n' < "$sandbox_marker")"
    [[ "$sandbox_id" =~ ^[0-9a-f]{64}$ ]] || continue
    if k0s ctr --namespace k8s.io containers info "$sandbox_id" >/dev/null 2>&1; then
      continue
    fi
    if ! task_list="$(k0s ctr --namespace k8s.io tasks list -q 2>/dev/null)"; then
      continue
    fi
    if printf '%s\n' "$task_list" | grep -Fxq "$sandbox_id"; then
      continue
    fi
    for command_line_file in /proc/[0-9]*/cmdline; do
      test -r "$command_line_file" || continue
      command_line="$(tr '\0' ' ' 2>/dev/null < "$command_line_file" || true)"
      case "$command_line" in
        *containerd-shim-kata-v2*" -id $sandbox_id "*) continue 2 ;;
      esac
    done
    if promotion_intended "$pod_uid"; then
      if ! promotion_intent_expired "$pod_uid"; then
        conclusion="$(promotion_job_conclusion "$pod_uid" || true)"
        case "$conclusion" in
          success) promote_job_dir "$job_dir" || true ;;
          cancelled|failure|neutral|skipped|stale|timed_out) ;;
          *) continue ;;
        esac
      fi
      rm -f -- "$request_dir/$pod_uid.intent"
    elif promotion_requested "$pod_uid"; then
      promote_job_dir "$job_dir" || true
    elif retention_active "$pod_uid"; then
      continue
    fi
    delete_job_dir "$job_dir"
  done < <(
    find "$jobs_dir" -mindepth 1 -maxdepth 1 -type d -print0
  )
}

while true; do
  verify_promotion_candidates
  clone_requests
  if (( SECONDS - last_sandbox_refresh >= 1 )); then
    record_active_sandboxes
    last_sandbox_refresh=$SECONDS
  fi
  prune_interval=30
  promotion_barrier_pending && prune_interval=5
  if (( SECONDS - last_prune >= prune_interval )); then
    prune_stale_jobs
    last_prune=$SECONDS
  fi
  sleep 0.2
done
