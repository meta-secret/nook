{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "dedupe": true
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "compat": ["docker2s2"],
    "accessControl": {
      "repositories": {
        "**": {
          "anonymousPolicy": ["read", "create", "update"]
        }
      }
    }
  },
  "log": {
    "level": "warn"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "tlsVerify": true,
          "preserveDigest": true,
          "maxRetries": 6,
          "retryDelay": "1s",
          "maxRetryDelay": "5s",
          "syncTimeout": "5m"
        }
      ]
    }
  }
}
