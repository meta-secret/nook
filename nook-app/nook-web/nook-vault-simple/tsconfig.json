{
  "extends": [
    "@tsconfig/svelte/tsconfig.json",
    "../tsconfig.safety.json",
    "../nook-web-shared/vault-module-paths.json"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client", "node"],
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "../nook-web-shared/src/vault-app/**/*.ts",
    "../nook-web-shared/src/vault-app/**/*.svelte",
    "**/*.ts",
    "**/*.svelte",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "../nook-web-shared/src/vault-app/lib/nook-wasm*",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-prod/**",
    "../nook-web-shared/src/vault-app/lib/nook-wasm",
    "../nook-web-shared/src/vault-app/lib/nook-wasm-*",
    "../nook-web-shared/src/extension/nook-companion-wasm"
  ]
}
