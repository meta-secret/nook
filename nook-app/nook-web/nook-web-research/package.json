{
  "name": "nook-web-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "bun run security && bun run unused && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unused": "knip --reporter compact",
    "security": "bun audit --prod --audit-level=high"
  },
  "dependencies": {
    "@lucide/svelte": "1.30.0",
    "@xyflow/svelte": "1.6.2",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "knip": "6.32.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
