{
  "id": "linkedin",
  "quirks": ["formless", "responsive-duplicate"],
  "steps": [
    {
      "fields": [
        {
          "type": "email",
          "autocomplete": "username",
          "aria-label": "Email or phone"
        },
        {
          "type": "password",
          "autocomplete": "current-password",
          "aria-label": "Password"
        }
      ],
      "submit": {
        "type": "button",
        "label": "Sign in"
      }
    }
  ]
}
