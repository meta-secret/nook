{
  "name": "nook-vault-sentinel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare:toolchain": "test -e ../node_modules || ln -s nook-web-app/node_modules ../node_modules; test -e node_modules || ln -s ../nook-web-app/node_modules node_modules",
    "dev": "bun run prepare:toolchain && vite",
    "build": "bun run prepare:toolchain && vite build",
    "preview": "bun run prepare:toolchain && vite preview",
    "check": "bun run prepare:toolchain && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@lucide/svelte": "1.30.0",
    "@internationalized/date": "^3.12.3",
    "bits-ui": "^2.18.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.13",
    "github-markdown-css": "5.9.0",
    "markdown-it": "15.0.0",
    "mermaid": "^11.16.1",
    "qr-code-styling": "1.9.2",
    "qr-scanner": "1.4.2",
    "svelte": "5.56.8",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.2.0",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
