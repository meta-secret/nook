{
  "name": "nook-vault-sentinel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "prepare:toolchain": "test -e ../node_modules || ln -s nook-web-app/node_modules ../node_modules; test -e node_modules || ln -s ../nook-web-app/node_modules node_modules",
    "dev": "bun run prepare:toolchain && vite",
    "build": "bun run prepare:toolchain && vite build",
    "preview": "bun run prepare:toolchain && vite preview",
    "check": "bun run prepare:toolchain && bun run lint && bun run typecheck",
    "lint": "node ../named-success-contract-check.ts . && cd .. && node_modules/.bin/oxlint -c oxlint.config.ts nook-vault-sentinel && node_modules/.bin/eslint --config eslint.config.js nook-vault-sentinel",
    "typecheck": "svelte-check --tsgo-experimental-api --tsconfig ./tsconfig.json && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "1.64.0",
    "bits-ui": "^2.20.2",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "effect": "4.1.0",
    "github-markdown-css": "5.9.0",
    "markdown-it": "15.0.3",
    "mermaid": "^12.2.0",
    "neverthrow": "8.2.0",
    "qr-code-styling": "1.9.2",
    "svelte": "5.57.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.0",
    "tw-animate-css": "1.4.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
