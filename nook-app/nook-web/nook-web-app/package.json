{
  "name": "nook-web-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "postinstall": "cd .. && test -e node_modules || ln -s nook-web-app/node_modules node_modules",
    "dev": "vite",
    "build": "bun run build:unified && bun run build:site && bun run build:simple && bun run build:sentinel && bun run assemble:preview && bun run verify:isolation",
    "build:unified": "vite build --mode unified",
    "build:site": "vite build --mode site",
    "build:simple": "cd ../nook-vault-simple && bun run build",
    "build:sentinel": "cd ../nook-vault-sentinel && bun run build",
    "assemble:preview": "bun scripts/assemble-preview.ts",
    "verify:isolation": "bun scripts/verify-app-isolation.ts",
    "preview": "vite preview",
    "i18n:keys:generate": "node scripts/generate-i18n-keys.mjs",
    "i18n:keys:check": "node scripts/generate-i18n-keys.mjs --check",
    "check": "bun run i18n:keys:check && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.config.json && cd ../nook-vault-simple && bun run check && cd ../nook-vault-sentinel && bun run check",
    "lint": "bun run security && bun run unused && bun run duplicates && cd .. && node_modules/.bin/eslint --config eslint.config.js nook-web-app nook-web-shared/src/vault-app nook-vault-simple nook-vault-sentinel && node_modules/.bin/prettier --check nook-web-app nook-web-shared/src/vault-app nook-vault-simple nook-vault-sentinel",
    "security": "bun audit --prod --audit-level=high",
    "unused": "knip --reporter compact",
    "duplicates": "cd ../../.. && nook-app/nook-web/node_modules/.bin/jscpd --config .jscpd.json nook-app preflight",
    "format": "prettier --write . ../nook-web-shared/src/vault-app ../nook-vault-simple ../nook-vault-sentinel",
    "format:check": "prettier --check . ../nook-web-shared/src/vault-app ../nook-vault-simple ../nook-vault-sentinel",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "bun run test:e2e:stable && bun run test:e2e:unstable",
    "test:e2e:stable": "PLAYWRIGHT_WORKERS=3 playwright test --project=stable",
    "test:e2e:unstable": "PLAYWRIGHT_WORKERS=2 playwright test --project=unstable",
    "test:e2e:pr": "bun run test:e2e:stable",
    "test:e2e:isolation": "playwright test --config playwright.isolation.config.ts",
    "test:e2e:local": "bun run test:e2e:stable",
    "test:e2e:sync-stub": "bun run test:e2e",
    "test:e2e:sync-live": "playwright test --project=sync-live",
    "test:e2e:github": "playwright test --project=sync-live",
    "test:e2e:multi-device": "PLAYWRIGHT_WORKERS=4 playwright test --project=unstable e2e/multi-device-sync.spec.ts",
    "test:ui-demo": "NOOK_UI_DEMO=1 PLAYWRIGHT_WORKERS=1 playwright test --project=ui-demo",
    "test:e2e:cleanup": "bun e2e/cleanup-github-repos.ts",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "^3.12.3",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/bun": "1.3.14",
    "@types/dompurify": "3.2.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.2.0",
    "@typescript-eslint/parser": "8.66.0",
    "bits-ui": "^2.18.1",
    "dotenv": "^17.4.2",
    "eslint": "10.8.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-svelte": "3.22.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "4.9.0",
    "globals": "17.9.0",
    "happy-dom": "20.11.2",
    "jscpd": "5.0.14",
    "knip": "5.88.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@lucide/svelte": "1.30.0",
    "@xyflow/svelte": "1.6.2",
    "clsx": "2.1.1",
    "dompurify": "3.4.13",
    "github-markdown-css": "5.9.0",
    "markdown-it": "15.0.0",
    "mermaid": "^11.16.1",
    "qr-code-styling": "1.9.2",
    "qr-scanner": "1.4.2",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.3",
    "@rolldown/binding-linux-x64-gnu": "1.2.3",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
