{
  "name": "nook-web-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "postinstall": "cd .. && test -e node_modules || ln -s nook-web-app/node_modules node_modules",
    "dev": "vite",
    "build": "bun run build:unified && bun run build:site && bun run build:simple && bun run build:sentinel && bun run assemble:preview && bun run verify:isolation",
    "build:unified": "vite build --mode unified",
    "build:site": "vite build --mode site",
    "build:simple": "cd ../nook-vault-simple && bun run build",
    "build:sentinel": "cd ../nook-vault-sentinel && bun run build",
    "assemble:preview": "bun scripts/assemble-preview.ts",
    "verify:isolation": "bun scripts/verify-app-isolation.ts",
    "preview": "vite preview",
    "i18n:keys:generate": "node scripts/generate-i18n-keys.mjs",
    "i18n:keys:check": "node scripts/generate-i18n-keys.mjs --check",
    "check": "bun run i18n:keys:check && bun run typecheck && cd ../nook-vault-simple && bun run check && cd ../nook-vault-sentinel && bun run check",
    "typecheck": "svelte-check --tsgo --workspace .. --config ./nook-web-app/svelte.config.js --tsconfig ./tsconfig.svelte.nook-web-app.json && tsc -p tsconfig.authored.json && tsc -p tsconfig.config.json",
    "lint": "bun run security && bun run unused && bun run duplicates && cd .. && node_modules/.bin/eslint --config eslint.config.js *.js nook-web-app nook-web-shared/src/vault-app nook-vault-simple nook-vault-sentinel && node_modules/.bin/prettier --check nook-web-app nook-web-shared/src/vault-app nook-vault-simple nook-vault-sentinel",
    "security": "bun audit --prod --audit-level=high",
    "unused": "knip --directory .. --reporter compact",
    "duplicates": "cd ../../.. && bash .github/scripts/jscpd-summary.sh nook-app/nook-web/node_modules/.bin/jscpd --config .jscpd.json nook-app preflight",
    "format": "prettier --write . ../nook-web-shared/src/vault-app ../nook-vault-simple ../nook-vault-sentinel",
    "format:check": "prettier --check . ../nook-web-shared/src/vault-app ../nook-vault-simple ../nook-vault-sentinel",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "failed=0; bun run test:e2e:stable || failed=1; bun run test:e2e:unstable || failed=1; exit \"$failed\"",
    "test:e2e:debug": "bun scripts/run-e2e-debug.ts",
    "test:e2e:stable": "playwright test --project=stable",
    "test:e2e:unstable": "playwright test --project=unstable",
    "test:e2e:pr": "bun run test:e2e:stable",
    "test:e2e:isolation": "playwright test --config playwright.isolation.config.ts",
    "test:e2e:local": "bun run test:e2e:stable",
    "test:e2e:sync-stub": "bun run test:e2e",
    "test:e2e:sync-live": "playwright test --project=sync-live",
    "test:e2e:github": "playwright test --project=sync-live",
    "test:e2e:multi-device": "playwright test --project=unstable e2e/multi-device-sync.spec.ts",
    "test:e2e:cleanup": "bun e2e/cleanup-github-repos.ts",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/bun": "1.4.4",
    "@types/chrome": "0.3.7",
    "@types/dompurify": "3.2.0",
    "@types/eslint-plugin-no-unsanitized": "4.1.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "bits-ui": "^2.20.2",
    "dotenv": "^18.0.9",
    "eslint": "10.13.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-svelte": "3.23.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "jscpd": "5.4.2",
    "knip": "6.44.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@lucide/svelte": "1.64.0",
    "@xyflow/svelte": "1.7.0",
    "clsx": "2.1.1",
    "dompurify": "3.4.17",
    "effect": "4.1.0",
    "fflate": "0.8.3",
    "github-markdown-css": "5.9.0",
    "markdown-it": "15.0.3",
    "mermaid": "^12.2.0",
    "neverthrow": "8.2.0",
    "qr-code-styling": "1.9.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.0",
    "tw-animate-css": "1.4.0",
    "zxing-wasm": "3.1.6"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "1.2.16",
    "@rolldown/binding-linux-x64-gnu": "1.2.16",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "overrides": {
    "devalue": "5.9.3",
    "dompurify": "3.4.17"
  }
}
