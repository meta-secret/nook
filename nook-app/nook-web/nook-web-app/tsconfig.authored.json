{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["svelte", "vite/client", "node", "bun", "chrome"]
  },
  "include": [
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.svelte",
    "playwright*.ts",
    "../nook-web-shared/src/vault-app/**/*.ts",
    "../nook-web-shared/src/vault-app/**/*.svelte",
    "**/*.ts",
    "**/*.svelte",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    "../*.js",
    "../*.mjs",
    "../*.cjs"
  ],
  "exclude": [
    "src/lib",
    "../nook-web-shared/src/vault-app/lib/nook-wasm",
    "../nook-web-shared/src/vault-app/lib/nook-wasm-*",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-prod/**",
    "../nook-web-shared/src/extension/nook-companion-wasm"
  ]
}
