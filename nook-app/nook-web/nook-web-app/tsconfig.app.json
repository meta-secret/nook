{
  "extends": [
    "@tsconfig/svelte/tsconfig.json",
    "../tsconfig.safety.json",
    "./config/tsconfig.paths.json"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client", "node", "chrome"],
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.cjs",
    "../nook-web-shared/src/vault-app/**/*.ts",
    "../nook-web-shared/src/vault-app/**/*.svelte",
    "../nook-web-shared/src/vault-app/**/*.js",
    "../nook-web-shared/src/vault-app/**/*.mjs",
    "../nook-web-shared/src/vault-app/**/*.cjs",
    "tests/**/*.ts",
    "tests/**/*.svelte"
  ],
  "exclude": [
    "src/lib",
    "../nook-web-shared/src/vault-app/lib/nook-wasm",
    "../nook-web-shared/src/vault-app/lib/nook-wasm-*",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-prod/**",
    "../nook-web-shared/src/extension/nook-companion-wasm"
  ]
}
