{
  "extends": [
    "@tsconfig/svelte/tsconfig.json",
    "../tsconfig.safety.json"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": [
      "svelte",
      "vite/client",
      "node",
      "chrome"
    ],
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "paths": {
      "nook-wasm": [
        "../nook-web-shared/src/vault-app/lib/nook-wasm/nook_wasm.js"
      ],
      "$lib": [
        "../nook-web-shared/src/vault-app/lib"
      ],
      "$lib/*": [
        "../nook-web-shared/src/vault-app/lib/*"
      ],
      "$vault-shared": [
        "../nook-web-shared/src/vault-app"
      ],
      "$vault-shared/*": [
        "../nook-web-shared/src/vault-app/*"
      ],
      "$web-shared/*": [
        "../nook-web-shared/src/*"
      ],
      "$app-wasm": [
        "../nook-web-shared/src/vault-app/lib/nook-wasm/nook_wasm"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.js",
    "src/**/*.mjs",
    "src/**/*.cjs",
    "../nook-web-shared/src/**/*.ts",
    "../nook-web-shared/src/**/*.svelte",
    "../nook-web-shared/src/**/*.js",
    "../nook-web-shared/src/**/*.mjs",
    "../nook-web-shared/src/**/*.cjs",
    "tests/**/*.ts",
    "tests/**/*.svelte"
  ],
  "exclude": [
    "src/lib",
    "../nook-web-shared/src/vault-app/lib/nook-wasm",
    "../nook-web-shared/src/vault-app/lib/nook-wasm-*",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-prod/**",
    "../nook-web-shared/src/extension/nook-companion-wasm"
  ]
}
