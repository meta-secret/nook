{
  "extends": "./nook-web-app/tsconfig.app.json",
  "include": [
    "**/*.ts",
    "**/*.svelte",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs"
  ],
  "exclude": [
    "nook-web-shared/src/vault-app/lib/nook-wasm",
    "nook-web-shared/src/vault-app/lib/nook-wasm-*",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-prod/**",
    "nook-web-shared/src/extension/nook-companion-wasm"
  ],
  "compilerOptions": {
    "types": [
      "svelte",
      "vite/client",
      "node",
      "bun",
      "chrome"
    ]
  }
}
