{
  "extends": "./tsconfig.json",
  "include": [
    ".github/**/*.ts",
    ".github/**/*.js",
    ".github/**/*.mjs",
    ".github/**/*.cjs",
    "infra/**/*.ts",
    "infra/**/*.js",
    "infra/**/*.mjs",
    "infra/**/*.cjs",
    "agentic-ai/minds/hive/controller/**/*.ts",
    "agentic-ai/minds/hive/controller/**/*.js",
    "agentic-ai/minds/hive/controller/**/*.mjs",
    "agentic-ai/minds/hive/controller/**/*.cjs",
    "eslint.config.mjs"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.js",
    "**/*.test.mjs",
    "**/*.test.cjs",
    "**/test/**",
    "**/tests/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/target/**"
  ]
}
