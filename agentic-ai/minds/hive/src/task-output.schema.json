{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changed_files", "tests", "obsolete", "blocker"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "obsolete": {
      "type": "boolean",
      "description": "Set true only when a blocker is retiring without resolving its prerequisite because every active owning Main repair is already delivered."
    },
    "blocker": {
      "type": "object",
      "description": "Set present=true with non-empty details only for blocked status. For completed or failed status, set present=false and all three detail strings to empty.",
      "additionalProperties": false,
      "required": ["present", "id", "title", "prompt"],
      "properties": {
        "present": { "type": "boolean" },
        "id": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" }
      }
    }
  }
}
