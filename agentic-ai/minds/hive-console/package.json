{
  "name": "nook-hive-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" \"locales/**/*.json\" \"*.{ts,js,json,md,html}\" .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" \"locales/**/*.json\" \"*.{ts,js,json,md,html}\" .prettierrc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "1.21.0",
    "svelte": "5.56.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "24.13.2",
    "prettier": "3.8.4",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.6.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
