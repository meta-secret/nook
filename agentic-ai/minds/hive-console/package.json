{
  "name": "nook-hive-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" \"locales/**/*.json\" \"*.{ts,js,json,md,html}\" .prettierrc",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,css}\" \"e2e/**/*.ts\" \"locales/**/*.json\" \"*.{ts,js,json,md,html}\" .prettierrc",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "1.30.0",
    "svelte": "5.56.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.5",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
