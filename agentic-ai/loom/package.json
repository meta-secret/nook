{
  "name": "@nook/loom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "loom": "./src/cli.ts",
    "loom-module-delivery": "./src/module-delivery/cli.ts",
    "loom-module-experts": "./src/module-experts/cli.ts",
    "loom-structural-experts": "./src/structural-experts/cli.ts"
  },
  "scripts": {
    "loom": "bun run src/cli.ts",
    "module-delivery": "bun run src/module-delivery/cli.ts",
    "module-experts": "bun run src/module-experts/cli.ts",
    "structural-experts": "bun run src/structural-experts/cli.ts",
    "precheck": "bun run source-policy && bun run cortex-audit",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "source-policy": "bun run src/commands/loom-source-policy.ts . --ownership-from \"$LOOM_OWNERSHIP_FROM\"",
    "cortex-audit": "bun run src/cli.ts --default cortexAudit",
    "format": "prettier --config .prettierrc --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,md}\" .prettierrc .oxlintrc.json",
    "format:check": "prettier --config .prettierrc --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,md}\" .prettierrc .oxlintrc.json",
    "test": "bun test",
    "verify": "bun run format:check && bun run lint && bun run check && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/diff": "8.0.0",
    "@types/mdast": "4.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@nats-io/nats-core": "^3.4.0",
    "diff": "9.0.0",
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "neverthrow": "8.2.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "zod": "4.6.7"
  }
}
