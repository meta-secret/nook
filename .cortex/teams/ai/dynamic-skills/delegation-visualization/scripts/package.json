{
  "name": "@nook/delegation-visualization-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" executable-skill.json \"*.{json,md}\" eslint.config.js .prettierrc",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" executable-skill.json \"*.{json,md}\" eslint.config.js .prettierrc",
    "test": "bun test tests",
    "verify": "bun run format:check && bun run lint && bun run check && bun test tests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "yaml": "2.9.0"
  }
}
