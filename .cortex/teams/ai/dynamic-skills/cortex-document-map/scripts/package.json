{
  "name": "@nook/cortex-document-map-skill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" executable-skill.json \"*.{json,md}\" .oxlintrc.json .prettierrc",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" executable-skill.json \"*.{json,md}\" .oxlintrc.json .prettierrc",
    "test": "bun test tests",
    "verify": "bun run format:check && bun run lint && bun run check && bun test tests"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/mdast": "4.0.4",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "neverthrow": "8.2.0"
  }
}
