{
  "name": "@nook/executable-skills",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --no-error-on-unmatched-pattern --write \"*/src/**/*.ts\" \"*/tests/**/*.ts\" \"*/executable-skill.json\" \"*/SKILL.md\" \"*.{ts,json,md}\" eslint.config.js .prettierrc",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"*/src/**/*.ts\" \"*/tests/**/*.ts\" \"*/executable-skill.json\" \"*/SKILL.md\" \"*.{ts,json,md}\" eslint.config.js .prettierrc",
    "test": "bun test */tests",
    "verify": "bun run format:check && bun run lint && bun run check && bun test */tests"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "unified": "11.0.5"
  }
}
